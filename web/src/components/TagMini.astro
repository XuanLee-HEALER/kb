---
interface Props {
  tag: string;
  href?: string;
}
const { tag, href } = Astro.props;
const parts = tag.split("/");
---
<a
  class="tag-mini"
  href={href ?? `/?tag=${encodeURIComponent(tag)}`}
  data-tag={tag}
  data-stop-propagation
>
  {parts.map((p, i) => (
    <>
      {i > 0 && <span class="slash">/</span>}
      {p}
    </>
  ))}
</a>
