---
import type { EntryKind } from "../lib/types";
import { kindCls } from "../lib/kind-meta";

interface Props {
  kind: EntryKind;
}
const { kind } = Astro.props;
const cls = kindCls(kind);
---
<span class={`badge icon-lucide kindfg-${cls}`}>
  {kind === "Fact" && (
    <svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12l5 5 9-11" />
    </svg>
  )}
  {kind === "ProblemSolution" && (
    <svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="9" />
      <path d="M9 9c0-2 1.5-3 3-3s3 1 3 3-3 2-3 4" />
      <circle cx="12" cy="17" r=".5" />
    </svg>
  )}
  {kind === "Lesson" && (
    <svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3l10 18H2L12 3z" />
      <path d="M12 10v4" />
      <circle cx="12" cy="17" r=".5" />
    </svg>
  )}
  {kind === "Decision" && (
    <svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 12l4-4 4 4-4 4-4-4z" />
      <path d="M13 12l4-4 4 4-4 4-4-4z" />
    </svg>
  )}
  {kind === "Heuristic" && (
    <svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="9" />
      <path d="M3 12c4 2 14 2 18 0" />
      <path d="M12 3c2 3 2 15 0 18" />
    </svg>
  )}
  <span>{kind}</span>
</span>
