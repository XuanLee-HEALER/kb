---
import type { Entry } from "../lib/types";
interface Props {
  entry: Entry;
}
const { entry: e } = Astro.props;

function str(k: string): string {
  const v = (e as unknown as Record<string, unknown>)[k];
  return typeof v === "string" ? v : "";
}
function arr(k: string): string[] {
  const v = (e as unknown as Record<string, unknown>)[k];
  return Array.isArray(v) ? (v as string[]) : [];
}
function evidenceList(): Array<{ kind: string; content: string; captured_at: string }> {
  const v = (e as unknown as Record<string, unknown>)["evidence"];
  return Array.isArray(v)
    ? (v as Array<{ kind: string; content: string; captured_at: string }>)
    : [];
}
function altsList(): Array<{ option: string; why_not: string }> {
  const v = (e as unknown as Record<string, unknown>)["alternatives"];
  return Array.isArray(v)
    ? (v as Array<{ option: string; why_not: string }>)
    : [];
}
---

{e.kind === "Fact" && (
  <>
    <div class="field">
      <div class="field-label"><span class="nk">◆ NK</span><span>claim</span></div>
      <div class="field-value">{str("claim")}</div>
    </div>
    <div class="field">
      <div class="field-label"><span>evidence</span></div>
      <div style="display: flex; flex-direction: column; gap: 8px">
        {evidenceList().map((ev) => (
          <div class="field-evidence">
            <span class="kind">{ev.kind}</span>
            <span class="content">{ev.content}</span>
            <span class="date">captured · {ev.captured_at}</span>
          </div>
        ))}
      </div>
    </div>
  </>
)}

{e.kind === "ProblemSolution" && (
  <>
    <div class="field">
      <div class="field-label"><span>problem</span></div>
      <div class="field-value">{str("problem")}</div>
    </div>
    <div class="field">
      <div class="field-label"><span>environment</span></div>
      <div class="field-value mono">{str("environment")}</div>
    </div>
    <div class="field">
      <div class="field-label"><span class="nk">◆ NK</span><span>symptoms</span></div>
      <ul class="field-list">
        {arr("symptoms").map((s) => <li>{s}</li>)}
      </ul>
    </div>
    <div class="field">
      <div class="field-label"><span class="nk">◆ NK</span><span>root_cause</span></div>
      <div class="field-value">{str("root_cause")}</div>
    </div>
    <div class="field">
      <div class="field-label"><span>solution</span></div>
      <div class="field-value">{str("solution")}</div>
    </div>
    {str("verification") && (
      <div class="field">
        <div class="field-label"><span>verification</span></div>
        <div class="field-value">{str("verification")}</div>
      </div>
    )}
  </>
)}

{e.kind === "Lesson" && (
  <>
    <div class="field">
      <div class="field-label"><span class="nk">◆ NK</span><span>trap</span></div>
      <div class="field-value">{str("trap")}</div>
    </div>
    <div class="field">
      <div class="field-label"><span>correction</span></div>
      <div class="field-value">{str("correction")}</div>
    </div>
    <div class="field">
      <div class="field-label"><span>why</span></div>
      <div class="field-value">{str("why")}</div>
    </div>
    {str("context") && (
      <div class="field">
        <div class="field-label"><span>context</span></div>
        <div class="field-value">{str("context")}</div>
      </div>
    )}
  </>
)}

{e.kind === "Decision" && (
  <>
    <div class="field">
      <div class="field-label"><span class="nk">◆ NK</span><span>context</span></div>
      <div class="field-value">{str("context")}</div>
    </div>
    <div class="field">
      <div class="field-label"><span class="nk">◆ NK</span><span>decision</span></div>
      <div class="field-value">{str("decision")}</div>
    </div>
    <div class="field">
      <div class="field-label"><span>rationale</span></div>
      <div class="field-value">{str("rationale")}</div>
    </div>
    {altsList().length > 0 && (
      <div class="field">
        <div class="field-label"><span>alternatives</span></div>
        <div>
          {altsList().map((a) => (
            <div class="alt">
              <span class="opt">{a.option}</span>
              <span class="why">
                <span class="why-label">why_not:&nbsp;</span>{a.why_not}
              </span>
            </div>
          ))}
        </div>
      </div>
    )}
    {arr("tradeoffs").length > 0 && (
      <div class="field">
        <div class="field-label"><span>tradeoffs</span></div>
        <div>
          {arr("tradeoffs").map((t) => <div class="tradeoff">{t}</div>)}
        </div>
      </div>
    )}
  </>
)}

{e.kind === "Heuristic" && (
  <>
    <div class="field">
      <div class="field-label"><span class="nk">◆ NK</span><span>problem_class</span></div>
      <div class="field-value">{str("problem_class")}</div>
    </div>
    <div class="field">
      <div class="field-label"><span class="nk">◆ NK</span><span>pattern</span></div>
      <div class="field-value">{str("pattern")}</div>
    </div>
    {str("limits") && (
      <div class="field">
        <div class="field-label"><span>limits</span></div>
        <div class="field-value">{str("limits")}</div>
      </div>
    )}
  </>
)}
