---
import Base from "../layouts/Base.astro";
import { kb } from "../lib/kb-client";
import type { Stats } from "../lib/types";

let stats: Stats | null = null;
let error: string | null = null;
try {
  stats = await kb.stats();
} catch (e) {
  error = (e as Error).message;
}
---

<Base title="Stats" active="stats">
  <h1 class="h1">Stats</h1>
  {error && <div class="callout">load failed: {error}</div>}
  {
    stats && (
      <>
        <table class="stats" style="max-width: 480px; margin-bottom: 32px;">
          <tbody>
            <tr><th>Total</th><td>{stats.total}</td></tr>
            <tr><th>Active</th><td>{stats.active}</td></tr>
            <tr><th>Deprecated</th><td>{stats.deprecated}</td></tr>
          </tbody>
        </table>
        <h2 class="h2">By kind</h2>
        <table class="stats" style="max-width: 480px;">
          <thead>
            <tr><th>Kind</th><th>Active</th><th>Deprecated</th></tr>
          </thead>
          <tbody>
            {stats.by_kind.map((k) => (
              <tr>
                <td><span class={`chip kind-${k.kind}`}>{k.kind}</span></td>
                <td>{k.active}</td>
                <td>{k.deprecated}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }
</Base>
