---
import Base from "../layouts/Base.astro";
import Stripe3 from "../components/Stripe3.astro";
import KindFieldsForm from "../components/KindFieldsForm.astro";
import { kb } from "../lib/kb-client";
import { KINDS, KIND_META } from "../lib/kind-meta";
import type { EntryKind } from "../lib/types";

const url = Astro.url;
const presetKind = (KINDS.includes(url.searchParams.get("kind") as EntryKind)
  ? url.searchParams.get("kind")
  : "ProblemSolution") as EntryKind;
const supersedes = url.searchParams.get("supersedes") ?? "";

// Build the autocomplete set from existing entries' tags.
let allTags: string[] = [];
try {
  const hits = await kb.search({ limit: 300 });
  const s = new Set<string>();
  for (const h of hits) for (const t of h.tags) s.add(t);
  allTags = [...s].sort();
} catch {
  /* offline OK */
}

const metaJson = JSON.stringify(
  Object.fromEntries(KINDS.map((k) => [k, KIND_META[k]])),
);
---

<Base title="New entry" active="new">
  <div data-page="new">
    <form action="/api/write" method="POST">
      <div class="ph">
        <div class="ph-title">
          <div class="ph-eyebrow">
            <Stripe3 vertical={false} />
            <span>new entry · 新建条目</span>
          </div>
          <h1>Write a new entry</h1>
          <div class="ph-sub">Choose the kind first — the field set follows.</div>
        </div>
        <div class="ph-actions">
          <a class="btn ghost" href="/">Cancel</a>
          <button type="submit" class="btn primary">
            Create
            <span style="font-family: var(--font-mono); font-size: 10.5px; opacity: .7; margin-left: 4px">⌘↵</span>
          </button>
        </div>
      </div>

      <div class="gate-banner">
        <Stripe3 vertical={true} />
        <div class="content">
          <span>
            <strong>Would a generic LLM answer this correctly without lookup?</strong>{" "}
            If yes, this isn't a delta — don't write it.
          </span>
          <span class="zh">通用 LLM 不用查就能答对吗?能 → 这就不是 delta,别写。</span>
        </div>
      </div>

      <div class="form-grid">
        <div>
          <!-- Kind picker -->
          <div style="margin-bottom: 18px" data-kind-switcher data-meta={metaJson}>
            <input type="hidden" name="kind" value={presetKind} />
            <div class="fld-label" style="margin-bottom: 10px">
              <span>kind</span>
              <span class="hint">选择条目类型 · the field set is determined by kind</span>
            </div>
            <div class="kind-picker">
              {KINDS.map((k) => {
                const m = KIND_META[k];
                return (
                  <div
                    class={`kind-pick-card kindfg-${m.cls}`}
                    data-kind-option={k}
                    role="button"
                    tabindex="0"
                    aria-selected={k === presetKind ? "true" : undefined}
                    style={k === presetKind ? "border-color: currentColor; background: var(--sakya-bg-surface1)" : ""}
                  >
                    <div class="swatch" />
                    <div class="name" style="color: var(--sakya-fg-primary)">{k}</div>
                    <div class="zh">{m.zh}</div>
                    <div class="blurb">
                      {m.blurb}<br /><span style="color: var(--sakya-fg-disabled)">{m.blurbZh}</span>
                    </div>
                    <div class="nk-list">NK · <span>◆ {m.nkList.join(", ")}</span></div>
                  </div>
                );
              })}
            </div>
          </div>

          <div class="fld">
            <div class="fld-label"><span>title</span><span class="hint">human-readable, mutable; not used for dedup</span></div>
            <input
              class="fld-input"
              name="title"
              required
              placeholder='A scannable name. Imperative or fact, e.g. "tmux 3.4 dropped setw alias".'
              style="font-size: 16px"
            />
          </div>

          <div class="fld">
            <div class="fld-label"><span>tags</span><span class="hint">domain/specific convention · 路径风格</span></div>
            <div data-tag-input data-all-tags={JSON.stringify(allTags)}>
              <input type="hidden" name="tags" value="[]" />
            </div>
          </div>

          <div style="margin: 20px 0 14px; display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--sakya-fg-tertiary); white-space: nowrap">
            <Stripe3 vertical={false} />
            <span data-kind-fields-label>{presetKind.toLowerCase()} fields · 字段</span>
            <span style="flex: 1; height: 1px; background: var(--sakya-border-subtle); margin-left: 6px"></span>
          </div>

          {KINDS.map((k) => <KindFieldsForm kind={k} />)}

          <div class="fld" style="margin-top: 10px">
            <div class="fld-label">
              <span>body</span>
              <span class="hint">
                markdown · prose that doesn't fit the schema ·{" "}
                <code style="font-family: var(--font-mono); color: var(--kind-ps)">[[ULID]]</code> 引用其它条目
              </span>
            </div>
            <textarea class="fld-textarea body" name="body" placeholder="Optional. Markdown. Use [[ULID]] to link other entries."></textarea>
          </div>

          <input type="hidden" name="supersedes" value={supersedes} />

          <div class="form-footer">
            <div class="hint">
              <span class="kbd">⌘↵</span> submit&nbsp;&nbsp;<span class="kbd">⎋</span> cancel
            </div>
            <div style="display: flex; gap: 8px">
              <a class="btn ghost" href="/">Cancel</a>
              <button type="submit" class="btn primary">Create entry</button>
            </div>
          </div>
        </div>

        <aside class="form-meta-side">
          <h4><Stripe3 vertical={false} /> Hints</h4>
          <p>
            <strong style="color: var(--sakya-fg-primary)">Why this kind?</strong>
            <br /><span style="color: var(--sakya-fg-secondary)" data-hint-blurb>{KIND_META[presetKind].blurb}</span>
            <br /><span data-hint-blurb-zh>{KIND_META[presetKind].blurbZh}</span>
          </p>
          <p>
            <strong style="color: var(--sakya-fg-primary)">◆ NK fields</strong>
            <br /><span style="font-family: var(--font-mono); font-size: 11.5px; color: var(--sakya-fg-secondary)" data-hint-nk>{KIND_META[presetKind].nkList.join(", ")}</span>
            <br />These participate in dedup identity. Changes here may trigger duplicates.
          </p>
          <h4 style="margin-top: 4px">Shortcuts</h4>
          <div class="kbd-row">
            <span class="k">⌘ ↵</span><span>submit</span>
            <span class="k">⎋</span><span>cancel</span>
            <span class="k">⌘ K</span><span>search</span>
            <span class="k">[ [</span><span>insert ULID ref</span>
          </div>
          {supersedes ? (
            <>
              <h4 style="margin-top: 4px">Supersede</h4>
              <p>
                Replacing <code style="font-family: var(--font-mono); font-size: 11px">{supersedes.slice(0, 12)}…</code>.
                Old entry will be deprecated atomically on submit.
              </p>
            </>
          ) : (
            <>
              <h4 style="margin-top: 4px">Supersede</h4>
              <p>
                If this entry replaces an existing one, paste its ULID below. The old one will be deprecated atomically on submit.<br />
                新条目若取代旧条目,可贴入旧 ULID。
              </p>
              <input
                class="fld-input"
                placeholder="01H… (optional)"
                style="font-family: var(--font-mono); font-size: 12px; padding: 6px 10px"
                data-supersedes-mirror
              />
            </>
          )}
        </aside>
      </div>
    </form>
  </div>
</Base>

<script>
  // Mirror the sidebar "supersedes" input into the form's hidden field.
  const mirror = document.querySelector<HTMLInputElement>("[data-supersedes-mirror]");
  const real = document.querySelector<HTMLInputElement>('input[name="supersedes"]');
  if (mirror && real) {
    mirror.addEventListener("input", () => { real.value = mirror.value; });
  }
</script>
